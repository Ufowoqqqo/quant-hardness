{
  "commands": [
    [
      "single",
      [
        "build/faiss_phase5a_bench",
        "single",
        "configs/indexes/phase5b_compression_robustness.conf"
      ]
    ],
    [
      "single_analysis",
      [
        "/tmp/phase3b-plot-env/bin/python",
        "scripts/analyze_phase5b.py",
        "--stage",
        "single"
      ]
    ],
    [
      "concurrent",
      [
        "build/faiss_phase5a_bench",
        "concurrent",
        "configs/indexes/phase5b_compression_robustness.conf"
      ]
    ],
    [
      "final_analysis",
      [
        "/tmp/phase3b-plot-env/bin/python",
        "scripts/analyze_phase5b.py",
        "--stage",
        "final"
      ]
    ]
  ],
  "environment": {
    "OMP_NUM_THREADS": "1",
    "OPENBLAS_NUM_THREADS": "1",
    "MKL_NUM_THREADS": "1"
  }
}